#!/usr/bin/env bash
# bstack-solutions — deterministic knowledge-first search over docs/solutions/.
#
# Why: the "knowledge-first" hard rule fires on every plan/debug/brainstorm.
# Letting the agent grep + read whole solution files burns tokens. This script
# digests the store into compact hits so the agent reads ONE file, not all of them.
#
# Storage: docs/solutions/<category>/<slug>.md  (YAML frontmatter: title, category, tags, added)
#
# Commands:
#   bstack-solutions search '<query>'   ranked compact hits (title/tags/body) — RUN THIS FIRST
#   bstack-solutions index              regenerate docs/solutions/INDEX.md from frontmatter
#   bstack-solutions find <slug>        print path + frontmatter for one solution
#   bstack-solutions list               one compact line per solution
#   bstack-solutions stats              counts by category
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
SOL_DIR="$REPO_ROOT/docs/solutions"
INDEX="$SOL_DIR/INDEX.md"
mkdir -p "$SOL_DIR"

# Collect solution markdown files (skip INDEX, jsonl, patterns dir is included).
_files() { find "$SOL_DIR" -type f -name '*.md' ! -name 'INDEX.md' 2>/dev/null | sort; }

# Emit "path<TAB>category<TAB>title<TAB>tags" for every solution, parsing frontmatter.
_meta() {
  _files | while IFS= read -r f; do
    python3 - "$f" "$SOL_DIR" <<'PY'
import sys, os, re
f, root = sys.argv[1], sys.argv[2]
txt = open(f, encoding='utf-8', errors='replace').read()
title = category = ''
tags = ''
m = re.match(r'^---\n(.*?)\n---', txt, re.S)
if m:
    for line in m.group(1).splitlines():
        k, _, v = line.partition(':')
        k, v = k.strip(), v.strip().strip('"\'')
        if k == 'title': title = v
        elif k == 'category': category = v
        elif k == 'tags': tags = v.strip('[]')
rel = os.path.relpath(f, root)
if not category:
    category = rel.split(os.sep)[0] if os.sep in rel else 'uncategorized'
if not title:
    title = os.path.splitext(os.path.basename(f))[0].replace('-', ' ')
print('\t'.join([rel, category, title, tags]))
PY
  done
}

cmd="${1:-search}"; shift || true

case "$cmd" in
  search)
    Q="${1:-}"
    [ -z "$Q" ] && { echo "usage: bstack-solutions search '<query>'" >&2; exit 1; }
    # Semantic backend first (gbrain, if installed + initialized): catches paraphrase
    # matches regex can't. Non-zero/empty result falls through to the regex ranker.
    if command -v gbrain >/dev/null 2>&1 && [ -d "$REPO_ROOT/.gbrain" ]; then
      GB_OUT=$(gbrain search "$Q" --path "$SOL_DIR" --limit 5 2>/dev/null || true)
      if [ -n "$GB_OUT" ]; then
        echo "$GB_OUT" | sed 's/^/  /'
        echo "  (semantic hits via gbrain; 'bstack-solutions find <slug>' for one file)"
        exit 0
      fi
    fi
    if [ -z "$(_files)" ]; then
      echo "No solutions yet. Run /bstack:compound after a fix to seed docs/solutions/."
      exit 0
    fi
    # Rank: title/tag hit = strong, body hit = weak. Emit compact, with a 1-line excerpt.
    _files | while IFS= read -r f; do
      python3 - "$f" "$SOL_DIR" "$Q" <<'PY'
import sys, os, re
f, root, q = sys.argv[1], sys.argv[2], sys.argv[3].lower()
txt = open(f, encoding='utf-8', errors='replace').read()
low = txt.lower()
if q not in low:
    sys.exit(0)
title = ''
m = re.search(r'^title:\s*(.+)$', txt, re.M)
if m: title = m.group(1).strip().strip('"\'')
strong = (q in title.lower()) or re.search(r'^tags:.*%s' % re.escape(q), txt, re.M | re.I)
# first body line containing the query, trimmed
excerpt = ''
for line in txt.splitlines():
    if q in line.lower() and not line.startswith('#') and ':' not in line[:8]:
        excerpt = line.strip()[:100]; break
rel = os.path.relpath(f, root)
rank = 0 if strong else 1
print('%d\t%s\t%s\t%s' % (rank, rel, title or rel, excerpt))
PY
    done | sort -t$'\t' -k1,1n | cut -f2- | awk -F'\t' '
      { printf "  %-42s %s\n", $1, $2; if ($3 != "") printf "  %-42s   ::%s\n", "", $3 }
      END { if (NR==0) print "  (no match — the problem may be novel; proceed and /bstack:compound the fix)" }'
    ;;

  index)
    {
      echo "# Solutions Index"
      echo ""
      echo "> Auto-generated by \`bin/bstack-solutions index\`. Do not edit by hand."
      echo ""
      echo "| Category | Solution | Title | Tags |"
      echo "|---|---|---|---|"
      _meta | awk -F'\t' '{ printf "| %s | `%s` | %s | %s |\n", $2, $1, $3, $4 }'
    } > "$INDEX"
    echo "wrote $INDEX ($(_files | wc -l | tr -d ' ') solutions)"
    ;;

  find)
    SLUG="${1:-}"
    [ -z "$SLUG" ] && { echo "usage: bstack-solutions find <slug>" >&2; exit 1; }
    HIT=$(_files | grep -E "/${SLUG}(\.md)?$|/${SLUG}[^/]*\.md$" | head -1 || true)
    [ -z "$HIT" ] && { echo "no solution matching '$SLUG'"; exit 0; }
    echo "$HIT"
    # Print the YAML frontmatter block only (between the first two --- fences).
    awk 'NR==1 && $0=="---"{f=1;next} f && $0=="---"{exit} f{print}' "$HIT"
    ;;

  list)
    _meta | awk -F'\t' '{ printf "  %-22s %-40s %s\n", $2, $1, $3 }'
    ;;

  stats)
    _meta | awk -F'\t' '{ c[$2]++ } END { for (k in c) printf "  %-20s %d\n", k, c[k] }' | sort
    ;;

  *)
    echo "bstack-solutions: unknown command '$cmd'" >&2
    echo "commands: search | index | find | list | stats" >&2
    exit 1
    ;;
esac
