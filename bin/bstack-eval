#!/usr/bin/env bash
# bstack-eval — golden-task eval runner (standards P-5.1/P-5.2).
#
# Deterministic suites run here and gate with exit codes; LLM-judged suites are
# specified in evals/llm/ and run via the benchmark-models skill (they need a model).
# Run BEFORE changing prompts, routes, checkers, or models; a regression blocks
# the change by the same BLOCKER semantics as code (P-5.2).
#
# Usage: bstack-eval            # all deterministic suites
#        bstack-eval routes     # router accuracy vs evals/routes.golden.tsv
#        bstack-eval migrate    # migrate-check verdicts vs evals/migrations fixtures
#        bstack-eval commands   # command structure via bstack-command-lint
set -uo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
EVALS="$REPO_ROOT/evals"
fails=0; total=0

# Fail LOUDLY on a missing fixture tree. Without this the routes and migrate suites
# silently contribute zero cases and the run still reports green — observed in a
# vendored install as "eval: 1/1 green" while 20 of 21 cases never executed. A gate
# that passes because it tested nothing is the worst possible outcome (G-09), and it
# is the same silent-success class as the router's old `[ -f ] || exit 0`.
if [ ! -d "$EVALS" ]; then
  printf '  ERROR: no eval fixtures at %s\n' "$EVALS" >&2
  printf '         The harness is incomplete, so NOTHING was verified. Not reporting green.\n' >&2
  printf '         fix: re-run  ./setup --project .  (setup vendors evals/)\n' >&2
  exit 1
fi
for _f in routes.golden.tsv migrations; do
  if [ ! -e "$EVALS/$_f" ]; then
    printf '  ERROR: missing eval fixture: evals/%s — refusing to report a partial run as green.\n' "$_f" >&2
    exit 1
  fi
done

check() { # check <name> <expected> <actual>
  total=$((total+1))
  if [ "$2" = "$3" ]; then printf "  PASS  %s\n" "$1"
  else printf "  FAIL  %s (expected: %s, got: %s)\n" "$1" "$2" "$3"; fails=$((fails+1)); fi
}

run_routes() {
  echo "── routes (router accuracy)"
  while IFS=$'\t' read -r prompt expected; do
    [ -z "$prompt" ] && continue; case "$prompt" in \#*) continue;; esac
    actual=$(printf '{"prompt":"%s"}' "$prompt" | bash "$REPO_ROOT/.claude/hooks/route.sh" 2>/dev/null | sed -n '2p' | awk '{print $1}')
    check "route: $prompt" "$expected" "${actual:-NONE}"
  done < "$EVALS/routes.golden.tsv"
}

run_migrate() {
  echo "── migrate (checker verdicts)"
  for f in "$EVALS"/migrations/*.ts; do
    base=$(basename "$f")
    case "$base" in *good*) expected=0 ;; *bad*) expected=1 ;; *) continue ;; esac
    "$REPO_ROOT/bin/bstack-migrate-check" "$f" > /dev/null 2>&1; actual=$?
    check "migrate: $base" "exit=$expected" "exit=$actual"
  done
}

run_commands() {
  echo "── commands (structure lint)"
  "$REPO_ROOT/bin/bstack-command-lint" > /dev/null 2>&1; actual=$?
  check "command-lint clean" "exit=0" "exit=$actual"
}

suite="${1:-all}"
case "$suite" in
  routes)   run_routes ;;
  migrate)  run_migrate ;;
  commands) run_commands ;;
  all)      run_routes; run_migrate; run_commands ;;
  *) echo "usage: bstack-eval [routes|migrate|commands|all]" >&2; exit 1 ;;
esac

echo ""
if [ "$fails" -eq 0 ]; then echo "  eval: $total/$total green."; exit 0; fi
echo "  eval: $fails/$total FAILED — do not roll out the change that caused this (P-5.2)."
exit 1
