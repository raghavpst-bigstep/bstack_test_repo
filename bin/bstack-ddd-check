#!/usr/bin/env bash
# bstack-ddd-check — deterministic DDD/Nx boundary scan.
#
# Why: the ddd-boundary-enforcer agent otherwise greps the tree and reads
# project.json files itself. This script does the mechanical scan once and
# emits ONLY the violations, so the agent reasons over a short list, not the repo.
#
# Usage:
#   bstack-ddd-check            scan the whole workspace (apps/ + libs/)
#   bstack-ddd-check --diff     scan only files changed vs. the base branch
#   bstack-ddd-check <path>     scan a single dir/file
#
# Exit code: 0 = clean, 1 = violations found (so callers can gate).
set -euo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT"

# Build the file list to scan, portably (no bash-4 mapfile — macOS ships bash 3.2,
# where mapfile is absent and `set -e` turns it into a hard 127 exit, so this gate
# could not run at all on a Mac while passing on CI's bash 5).
FILES=()
add_files() { while IFS= read -r _f; do [ -n "$_f" ] && FILES+=("$_f"); done; }
case "${1:-}" in
  --diff)
    BASE=$(git rev-parse --verify --quiet main >/dev/null 2>&1 && echo main || echo HEAD~1)
    add_files < <(git diff --name-only "$BASE"...HEAD -- 'apps/**' 'libs/**' 2>/dev/null | grep -E '\.(ts|tsx|js)$' || true)
    ;;
  "")
    add_files < <(find apps libs -type f \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' \) 2>/dev/null || true)
    ;;
  *)
    add_files < <(find "$1" -type f \( -name '*.ts' -o -name '*.tsx' -o -name '*.js' \) 2>/dev/null || true)
    ;;
esac

[ "${#FILES[@]}" -eq 0 ] && { echo "  (no source files to scan)"; exit 0; }

violations=0
report() { printf "  %-9s %s\n" "$1" "$2"; violations=$((violations+1)); }

for f in "${FILES[@]}"; do
  [ -f "$f" ] || continue
  # Which layer/app does this file belong to?
  layer=$(echo "$f" | cut -d/ -f1)          # apps | libs
  unit=$(echo "$f" | cut -d/ -f2)           # <app-name> | <lib-name>

  # Extract "lineno:importpath" for each import / require in the file.
  while IFS=: read -r line src; do
    [ -z "${src:-}" ] && continue
    # 1.1 / 1.2 — relative import that climbs into apps/
    if echo "$src" | grep -qE '\.\./.*apps/'; then
      report "CRITICAL" "$f:$line  relative import into apps/  ->  $src"
      continue
    fi
    # aliased/absolute import that targets some apps/<x>
    target_app=$(echo "$src" | grep -oE 'apps/[a-zA-Z0-9_-]+' | head -1 | cut -d/ -f2 || true)
    if [ -n "$target_app" ]; then
      if [ "$layer" = "libs" ]; then
        report "CRITICAL" "$f:$line  lib '$unit' imports app '$target_app' (rule 1.2)"
      elif [ "$layer" = "apps" ] && [ "$target_app" != "$unit" ]; then
        report "CRITICAL" "$f:$line  app '$unit' imports app '$target_app' (rule 1.1)"
      fi
    fi
  done < <(grep -nE "from[[:space:]]+['\"][^'\"]+['\"]|require\(['\"][^'\"]+['\"]\)" "$f" 2>/dev/null \
             | sed -E "s/^([0-9]+):.*['\"]([^'\"]+)['\"].*/\1:\2/")
done

if [ "$violations" -eq 0 ]; then
  echo "  DDD boundaries clean (${#FILES[@]} files scanned)."
  exit 0
fi
echo ""
echo "  $violations boundary violation(s). api-interfaces is the only cross-domain home (rule 1.3)."
exit 1
