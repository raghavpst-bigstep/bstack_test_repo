#!/usr/bin/env bash
# bstack-doc-drift — deterministic index/drift check for the command surface.
#
# Why: the command set is written down in five places (readme.md, MANIFEST.md,
# SessionStart.sh, the model-tier table, routes.tsv). Hand-maintained, they drift:
# a command lands but a count never moves, or a tier row forgets it. /bstack:improve
# used to reconcile this by eye (an LLM set-comparison over five files — slow, costly,
# non-reproducible). This script does it deterministically so the model only fixes
# what's flagged (standards P-2.2: deterministic pre-pass; P-4.5: codify the transform).
#
# Usage: bstack-doc-drift            # check all indexes against files on disk
# Exit 1 on any FAIL (gateable in CI and by /bstack:improve).
set -uo pipefail

REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null || pwd)
cd "$REPO_ROOT" || exit 2

CMD_DIR=".claude/commands/bstack"
README="readme.md"
MANIFEST="MANIFEST.md"
SESSION=".claude/hooks/SessionStart.sh"
CONV=".claude/config/command-conventions.md"
ROUTES=".claude/config/routes.tsv"

fails=0
row() { printf "  %-4s  %-22s %s\n" "$1" "$2" "$3"; [ "$1" = "FAIL" ] && fails=$((fails+1)); return 0; }

[ -d "$CMD_DIR" ] || { echo "  bstack-doc-drift: no $CMD_DIR — nothing to check."; exit 0; }

# --- source of truth: command stems on disk ---
stems=()
for f in "$CMD_DIR"/*.md; do [ -e "$f" ] || continue; b=$(basename "$f" .md); stems+=("$b"); done
N=${#stems[@]}
echo "  commands on disk: $N"

# a stem is "present" in a doc if /bstack:<stem> appears NOT followed by a hyphen or
# alnum (so /bstack:review does not spuriously match /bstack:review-doc).
present_slash() { grep -Eq "/bstack:$1([^A-Za-z0-9-]|\$)" "$2" 2>/dev/null; }

# --- 1. declared counts match N ---
rc=$(grep -oE 'Commands \(([0-9]+) total\)' "$README" 2>/dev/null | grep -oE '[0-9]+' | head -1)
[ "$rc" = "$N" ] && row PASS "readme count" "$rc == $N" || row FAIL "readme count" "readme says '${rc:-?}', disk has $N"
mc=$(grep -oE 'Commands \(([0-9]+)\)' "$MANIFEST" 2>/dev/null | grep -oE '[0-9]+' | head -1)
[ "$mc" = "$N" ] && row PASS "manifest count" "$mc == $N" || row FAIL "manifest count" "MANIFEST says '${mc:-?}', disk has $N"

# --- 2. every stem present in readme + MANIFEST (both are exhaustive indexes) ---
for label in "readme:$README" "manifest:$MANIFEST"; do
  name=${label%%:*}; file=${label#*:}; miss=""
  for s in "${stems[@]}"; do present_slash "$s" "$file" || miss="$miss $s"; done
  [ -z "$miss" ] && row PASS "$name lists all" "$N/$N" || row FAIL "$name missing" "${miss# }"
done
# SessionStart is a CURATED short list, not exhaustive — report uncovered as advisory.
if [ -f "$SESSION" ]; then
  smiss=""; for s in "${stems[@]}"; do present_slash "$s" "$SESSION" || smiss="$smiss $s"; done
  [ -z "$smiss" ] && row PASS "session lists all" "$N/$N" || row INFO "session omits (curated)" "${smiss# }"
fi

# --- 3. every stem appears exactly once in the model-tier table ---
tier_set=$(awk -F'|' '/^\| `(haiku|sonnet|opus)`/{print $3}' "$CONV" 2>/dev/null | tr ',' '\n' | sed 's/[`]//g; s/^[[:space:]]*//; s/[[:space:]]*$//' | grep -v '^$')
miss=""; dup=""
for s in "${stems[@]}"; do
  c=$(printf '%s\n' "$tier_set" | grep -cx "$s")
  [ "$c" = "0" ] && miss="$miss $s"
  [ "$c" -gt 1 ] 2>/dev/null && dup="$dup $s"
done
[ -z "$miss" ] && row PASS "tier table covers" "$N/$N" || row FAIL "tier table missing" "${miss# }"
[ -z "$dup" ] || row FAIL "tier table dup" "${dup# }"

# --- 4. reverse check: no phantom /bstack:<x> in readme/MANIFEST without a backing
# command file OR skill dir (the plugin exposes both as /bstack:<name>) ---
SKILLS_DIR=".claude/skills"
phantom=""
for doc in "$README" "$MANIFEST"; do
  while IFS= read -r ref; do
    { [ -e "$CMD_DIR/$ref.md" ] || [ -d "$SKILLS_DIR/$ref" ]; } || case " $phantom " in *" $ref "*) : ;; *) phantom="$phantom $ref";; esac
  done < <(grep -oE '/bstack:[a-z][a-z0-9-]*' "$doc" 2>/dev/null | sed 's#/bstack:##' | sort -u)
done
[ -z "$phantom" ] && row PASS "no phantom cmds" "readme+manifest" || row FAIL "phantom cmd ref" "${phantom# } (referenced, no file)"

# --- 5. routes are advisory: report stems with no route row (some legitimately have none) ---
if [ -f "$ROUTES" ]; then
  noroute=""
  for s in "${stems[@]}"; do grep -Eq "\t/bstack:$s\t" "$ROUTES" || noroute="$noroute $s"; done
  [ -z "$noroute" ] && row PASS "routes cover all" "$N/$N" || row INFO "no route (advisory)" "${noroute# }"
fi

echo ""
if [ "$fails" -eq 0 ]; then echo "  doc-drift: all indexes consistent with disk."; exit 0; fi
echo "  doc-drift: $fails FAIL(s) — an index disagrees with $CMD_DIR. Fix the index (disk wins)."
exit 1
